#!/bin/bash
#SBATCH -J idos                     ## name
#SBATCH -N 1                      ## 1 node
#SBATCH --ntasks-per-node=128       ## number of tasks per node
#SBATCH --time=06:10:00      

##SBATCH --exclude=n3510-027,n3510-028,n3510-009,n3510-010,n3510-001,n3510-002,n3510-045,n3510-046 ## exclude these nodes

#####
##### >>>>>>>>>PUBLIC QUEUE<<<<<<<<<<
##SBATCH --qos=mem_0096
##SBATCH --account=p71289
##SBATCH --partition=mem_0096
#####

##### >>>>>>>>>INSTITUTS QUEUE<<<<<<<<<<
##SBATCH --qos=zen3_0512_devel
#SBATCH --qos=p70623_0512
##SBATCH --account=p71070
#SBATCH --account=p70623
#SBATCH --partition=zen3_0512
#####

module purge

export MODULES_AUTO_HANDLING=1

module load miniforge3

eval "$(conda shell.bash hook)"

conda activate zen3basic
echo "Using python: $( python --version ) from $( which python )"



rm *.png


rm timer.dat

date >> timer.dat

rm out_idos.dat


for i in {0..399}   

do
	rm -r it_$i

	mkdir it_$i

	cp dos_numpy.py it_$i

	cd it_$i

	echo "iteration $i" >> it_counter.txt

	rm out_dos.dat

	date #>> out_dos.dat
	
	mpiexec -np 128 python3.14 dos_numpy.py #>> out_dos.dat

	date #>> out_dos.dat

	rm dos_numpy.py

	cd ..
	
	rm -r it_$i

done

mpiexec -np 128 python3.14 get_idos.py >> out_idos.dat

date >> timer.dat
